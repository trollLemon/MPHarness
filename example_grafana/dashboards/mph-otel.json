    "footer": {
     "show": false
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "mph-prometheus"
     },
     "expr": "max by (mph_iteration) (mph_model_prefill_ttft_seconds_sum{mph_run_id=\"$run\"})",
