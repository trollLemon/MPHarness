{
 "uid": "mph-otel",
 "title": "MPHarness - OTel (Metrics / Logs / Traces)",
 "tags": [
  "mph",
  "otel",
  "batch"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 5,
 "refresh": "30s",
 "editable": true,
 "description": "Telemetry from batch test runs, not a long-running service. The $run variable picks one run: the header states its outcome and totals, the time and token rows break that run down per iteration, the context and tools rows explain it, and the comparison row holds every run in the range. Runs are identified by mph_run_id, a <name>:<uuid> composite, so two runs sharing a name stay separate.",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "timepicker": {},
 "annotations": {
  "list": [
   {
    "name": "Compactions",
    "datasource": {
     "type": "prometheus",
     "uid": "mph-prometheus"
    },
    "enable": true,
    "iconColor": "red",
    "expr": "increase(mph_context_compactions_total[1m]) > 0",
    "titleFormat": "compaction",
    "textFormat": "{{mph_run_name}}"
   }
  ]
 },
 "templating": {
  "list": [
   {
    "name": "run",
    "label": "Run",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "mph-prometheus"
    },
    "query": {
     "query": "label_values(mph_context_tokens, mph_run_id)",
     "refId": "run-id"
    },
    "definition": "label_values(mph_context_tokens, mph_run_id)",
    "refresh": 2,
    "sort": 2,
    "multi": false,
    "includeAll": false,
    "current": {},
    "options": [],
    "hide": 0,
    "skipUrlSync": false
   },
   {
    "name": "run_name",
    "label": "Run name",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "mph-prometheus"
    },
    "query": {
     "query": "label_values(mph_context_tokens{mph_run_id=\"$run\"}, mph_run_name)",
     "refId": "run-name"
    },
    "definition": "label_values(mph_context_tokens{mph_run_id=\"$run\"}, mph_run_name)",
    "refresh": 1,
    "sort": 1,
    "multi": false,
    "includeAll": false,
    "current": {},
    "options": [],
    "hide": 2,
    "skipUrlSync": false
   }
  ]
 },
