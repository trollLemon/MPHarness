  {
   "id": 211,
   "type": "barchart",
   "title": "Iteration duration split",
   "description": "Per-iteration wall time split into model chat, tool execution, and overhead (total minus chat minus tools). Missing tool time is treated as zero; the total is not stacked alongside its components.",
   "datasource": {
    "type": "prometheus",
    "uid": "mph-prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 6
   },
"fieldConfig": {
 "defaults": {
   "decimals": 1,
   "color": {
    "mode": "palette-classic"
   },
   "custom": {
    "lineWidth": 1,
    "fillOpacity": 80,
    "gradientMode": "none",
    "axisPlacement": "auto"
   }
  },
    "overrides": [
    {
     "matcher": {
      "id": "byType",
      "options": "number"
     },
     "properties": [
      {
       "id": "unit",
       "value": "s"
      },
      {
       "id": "decimals",
       "value": 1
      }
     ]
    }
   ]
   },
   "options": {
    "xField": "iteration",
    "orientation": "vertical",
    "showValue": "auto",
    "stacking": "normal",
    "groupWidth": 0.7,
    "width": 0.9,
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "mph-prometheus"
     },
     "expr": "clamp_min(max by (mph_iteration) (max_over_time(mph_agent_iteration_duration_seconds_sum{mph_run_id=\"$run\"}[$__range])) - max by (mph_iteration) (max_over_time(mph_agent_chat_duration_seconds_sum{mph_run_id=\"$run\"}[$__range])) - (sum by (mph_iteration) (max_over_time(mph_agent_tool_duration_seconds_sum{mph_run_id=\"$run\"}[$__range])) or (max by (mph_iteration) (max_over_time(mph_agent_iteration_duration_seconds_sum{mph_run_id=\"$run\"}[$__range])) * 0)), 0)",
     "instant": true,
     "range": false,
     "format": "table",
     "legendFormat": "overhead"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "mph-prometheus"
     },
     "expr": "max by (mph_iteration) (max_over_time(mph_agent_chat_duration_seconds_sum{mph_run_id=\"$run\"}[$__range]))",
     "instant": true,
     "range": false,
     "format": "table",
     "legendFormat": "chat"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "mph-prometheus"
     },
     "expr": "sum by (mph_iteration) (max_over_time(mph_agent_tool_duration_seconds_sum{mph_run_id=\"$run\"}[$__range]))",
     "instant": true,
     "range": false,
     "format": "table",
     "legendFormat": "tools"
    }
   ],
"transformations": [
  {
   "id": "merge",
   "options": {}
  },
  {
   "id": "organize",
   "options": {
    "excludeByName": {
     "Time": true
    },
    "renameByName": {
     "Value #A": "overhead",
     "Value #B": "chat",
     "Value #C": "tools",
     "mph_iteration": "iteration"
    }
   }
  }
 ]
  },
  {
   "id": 212,
   "type": "table",
   "title": "Prefill TTFT",
   "description": "max by (mph_iteration) (mph_model_prefill_ttft_seconds_sum{mph_run_id=\"$run\"}) and max by (mph_iteration) (mph_model_prefill_cached_tokens_sum{mph_run_id=\"$run\"}). A short prefill with a large cached-token count is Incremental Message Caching reusing a prefix, not a fast model.",
   "datasource": {
    "type": "prometheus",
    "uid": "mph-prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 6,
    "x": 12,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "bar"
      },
      "inspect": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "ttft (s)"
