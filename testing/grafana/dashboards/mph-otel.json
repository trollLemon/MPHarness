          "expr": "sum by (mph_run_id) (last_over_time(mph_iterations_total[$__range]))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Iterations"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "mph-prometheus"
          },
