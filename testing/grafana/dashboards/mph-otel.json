{
  "uid": "mph-otel",
  "title": "MPHarness - OTel (Metrics / Logs / Traces)",
  "tags": [
    "mph",
    "otel",
    "batch"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "30s",
  "editable": true,
  "description": "Telemetry from batch test runs, not a long-running service. Panels show the last known value per run, so a finished run reads as a stable plateau instead of decaying to zero.",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "description": "OTel resource service.name, exposed by the Prometheus exporter as exported_job.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mph-prometheus"
        },
        "definition": "label_values(exported_job)",
        "query": {
          "query": "label_values(exported_job)",
          "refId": "service-var"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "sort": 1,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "loki_service",
        "label": "Service (logs)",
        "description": "Loki rejects matchers whose regex can match empty, so the All value is .+ rather than .*",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "mph-loki"
        },
        "definition": "label_values(service_name)",
        "query": {
          "query": "label_values(service_name)",
          "refId": "loki-service-var"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "sort": 1,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "run_id",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mph-prometheus"
        },
        "definition": "label_values(mph_iterations_total{exported_job=~\"$service\"}, mph_run_id)",
        "query": {
          "query": "label_values(mph_iterations_total{exported_job=~\"$service\"}, mph_run_id)",
          "refId": "StandardVariableQuery"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "sort": 1,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "trace_service",
        "label": "Trace service (Jaeger)",
        "description": "Jaeger search takes a single service name, so this is a textbox. Must match otel.service_name.",
        "type": "textbox",
        "query": "mph-smoke",
        "current": {
          "value": "mph-smoke",
          "text": "mph-smoke"
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Latest run (final value, flat after the run ends)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "description": ""
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tool calls",
      "datasource": {
        "type": "prometheus",
        "uid": "mph-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mph-prometheus"
          },
          "expr": "sum(last_over_time(mph_agent_tool_calls_total{exported_job=~\"$service\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "calls"
        }
      ],
      "description": ""
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tool failures",
      "description": "0 means every tool call in the run succeeded.",
      "datasource": {
        "type": "prometheus",
        "uid": "mph-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mph-prometheus"
          },
          "expr": "sum(last_over_time(mph_agent_tool_failures_total{exported_job=~\"$service\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "failures"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tool duration p95",
      "description": "p95 across the run window, not a live rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "mph-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mph-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(mph_agent_tool_duration_bucket{exported_job=~\"$service\"}[$__range])))",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Avg tokens/sec",
      "description": "Mean generation speed recorded during the run.",
      "datasource": {
        "type": "prometheus",
        "uid": "mph-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mph-prometheus"
          },
          "expr": "sum(last_over_time(mph_tokens_per_second_sum{exported_job=~\"$service\"}[$__range])) / sum(last_over_time(mph_tokens_per_second_count{exported_job=~\"$service\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "tokens/sec"
        }
      ]
    },
    {
