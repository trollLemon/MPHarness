            "uid": "mph-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (mph_run_id) (last_over_time(mph_context_tokens[$__range])) / sum by (mph_run_id) (last_over_time(mph_context_window[$__range]))",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "Context used"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
