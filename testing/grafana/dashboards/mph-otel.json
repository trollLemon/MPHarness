    {
      "id": 10,
      "type": "timeseries",
      "title": "Token usage history (cumulative per run)",
      "description": "Staircase of the cumulative token counter. Rises while a run is active, holds its final value afterwards, and dips when the next run restarts the counter. This is the history view.",
      "datasource": {
        "type": "prometheus",
        "uid": "mph-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mph-prometheus"
          },
          "expr": "sum by (tokens_type) (last_over_time(mph_tokens_sum{exported_job=~\"$service\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{tokens_type}}"
        }
      ]
    },
