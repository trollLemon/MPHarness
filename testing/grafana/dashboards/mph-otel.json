    {
      "id": 111,
      "type": "timeseries",
      "title": "Context window utilization per run over time",
      "description": "How close each run got to the model's context window, one line per run id, no run filter. Read it as a staircase, not a ramp: the level is only written once per iteration (recordTokenUsage adds the delta, so the series holds the last request's total tokens) and the collector re-publishes that same number on every 5s scrape, so linear interpolation would invent growth that never happened. spanNulls is off so each line ends with its run, but expect a ~5min flat tail: the OTel Prometheus exporter keeps a finished run's last value alive briefly before evicting it, so the line is trustworthy only up to that point. No upper axis bound is set because the ratio is not clamped - a request whose tokens exceed the effective window pushes it past 1. Rejected: increase() over this counter, which scrape-extrapolates the per-iteration steps into non-integer bursts (observed 1003.77 and 104.26 'tokens grown'), and last_over_time(...[$__range]), which flattens every run to a permanent horizontal line - the per-run final value is in the \"Per run totals\" table instead.",
      "datasource": {
        "type": "prometheus",
        "uid": "mph-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": false,
            "pointSize": 4,
            "axisSoftMin": 0,
            "axisSoftMax": null,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mph-prometheus"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (mph_run_id) (mph_context_tokens{}) / sum by (mph_run_id) (mph_context_window{})",
          "range": true,
          "instant": false,
          "legendFormat": "{{mph_run_id}}"
        }
      ]
    },
