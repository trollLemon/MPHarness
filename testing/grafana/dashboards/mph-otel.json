          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mph-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (mph_run_id) (last_over_time(mph_tokens_sum{tokens_type=\"total\"}[$__range]))",
