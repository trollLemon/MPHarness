    {
      "id": 110,
      "type": "timeseries",
      "title": "Tokens per interval, one line per run",
      "description": "Tokens consumed per interval rather than a running total, so each run reads as a burst that falls back to zero once it stops reporting. A cumulative line can only ever climb and leaves every finished run frozen at its total; the totals themselves are in the table above.",
      "datasource": {
        "type": "prometheus",
        "uid": "mph-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 6,
            "axisSoftMin": null,
            "axisSoftMax": null,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
